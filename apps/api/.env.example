# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (dev: `pnpm dev:db` starts an embedded server on 54329)
PG_HOST=127.0.0.1
PG_PORT=54329
PG_USER=postgres
PG_PASSWORD=postgres
CONTROL_DB=schoolsync_control
TENANT_DB_PREFIX=ss_

# Sites: <code>.localhost (Chrome resolves *.localhost to 127.0.0.1) or header X-Tenant: <code>
BASE_DOMAIN=localhost
ALLOW_TENANT_HEADER=true
# DEFAULT_TENANT=demo

# Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-dev-secret-change-me-0123456789
APP_ENCRYPTION_KEY=dev-encryption-key-change-me-0123456789abcdef
# PLATFORM_API_KEY=generate-a-long-random-string

# Operator console (/platform on the web app). The first operator is created at startup from these, only while no operator
# exists; they must change the password at first sign-in, then remove PLATFORM_ADMIN_PASSWORD. CLI alternative:
#   pnpm platform:operator --email you@company.com --password 'Choose#AStrongOne1'
# PLATFORM_ADMIN_EMAIL=you@company.com
# PLATFORM_ADMIN_PASSWORD=Temporary#Passw0rd
# operator sign-in attempts per minute per client address
# PLATFORM_LOGIN_RATE_LIMIT_MAX=10
# demo data in the create-school wizard: development only, never offered in production; false hides it everywhere
# PLATFORM_ALLOW_DEMO_DATA=false

CORS_ORIGINS=http://localhost:3000
# REDIS_URL=redis://127.0.0.1:6379/5

# Firebase Cloud Messaging (server side). Leave empty in dev: pushes are logged.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# SMTP_URL=smtp://user:pass@smtp.example.com:587
MIN_APP_VERSION=1.0.0
AUTH_RATE_LIMIT_MAX=200
# where the web app lives; {code} = school site code (used in password-reset emails)
PUBLIC_WEB_URL=http://{code}.localhost:3000

# Online fee payments (module: fees). mock = development only (refused when NODE_ENV=production).
# The Razorpay adapter is written from the public docs and has NOT been tested against the live/test API: run a
# test-mode payment end to end (order, checkout, webhook, refund) before enabling it for a school.
# Webhook URL to configure at the gateway: https://<school-host>/api/v1/payments/webhook/razorpay
# PAYMENT_GATEWAY=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Outgoing email. SMTP_URL / MAIL_FROM above are the PLATFORM default sender, used by schools that have not added their own
# email account (Settings > School profile > Email). Each school can add its own SMTP accounts; the queue sends one message at
# a time per school, EMAIL_SEND_INTERVAL_MS apart.
# EMAIL_SEND_INTERVAL_MS=300
# DEV/TEST ONLY: allow a school's SMTP host to be loopback/private (e.g. a local stub server) and any port. The API refuses to
# start in production with this set. Leave it off anywhere a school admin is not fully trusted: it disables the SSRF guard.
# ALLOW_PRIVATE_SMTP=true
