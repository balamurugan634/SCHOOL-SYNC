{
  "name": "@school-sync/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "site:create": "tsx src/cli/site-create.ts",
    "site:migrate": "tsx src/cli/site-migrate.ts",
    "site:seed-demo": "tsx src/cli/seed-demo.ts",
    "openapi": "tsx src/cli/export-openapi.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "billing": "tsx src/cli/billing.ts",
    "site:drop": "tsx src/cli/site-drop.ts",
    "site:reset-demo": "tsx src/cli/site-drop.ts --code demo --yes && tsx src/cli/site-create.ts --code demo --name \"Green Valley Public School\" --admin-email admin@greenvalley.edu --admin-password Demo@12345 --price 150 --seats 500 --color '#1B6B4F' --demo"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@node-rs/argon2": "^2.0.2",
    "@school-sync/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lru-cache": "^11.5.3",
    "nodemailer": "^10.1.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
