# ── SchoolSync web (Next.js) ────────────────────────────────────────────────────
# Copy to .env.local for local development.

# Where the Fastify API lives (server-side only; the browser never talks to it directly).
API_URL=http://localhost:4000

# School (site) resolution. The web app resolves the school from the request host:
#   <code>.<BASE_DOMAIN>  (e.g. demo.localhost:3000 in dev, greenvalley.schoolsync.app in prod)
#   → a custom domain registered in the API (tenant_domains)
#   → the cookie set by the "Find your school" page (dev / single-host installs)
#   → NEXT_PUBLIC_DEFAULT_SITE
#   → otherwise the "Find your school" page.
BASE_DOMAIN=localhost
# Public base used to build school URLs on the Find-your-school page (host[:port]).
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
NEXT_PUBLIC_DEFAULT_SITE=demo
# cookie = remember the chosen school in a cookie (dev)   redirect = send the visitor to <code>.<BASE_DOMAIN> (prod)
SITE_SELECT_MODE=cookie

# Cookies: Secure + __Host- prefix. Defaults to true when NODE_ENV=production.
# Set to false only for an http://localhost production smoke-test.
# COOKIE_SECURE=false

# Dev-only: role-shell preview route (/dev/preview/<student|parent|teacher|management>) and the `ss_dev_brand` cookie that
# previews another school colour. Always off in production.
# ENABLE_DEV_PREVIEW=true

