# Copy to infra/.env — NEVER commit the real file.
BASE_DOMAIN=schoolsync.example.com
ACME_EMAIL=ops@example.com

PG_USER=postgres
PG_PASSWORD=change-me-long-random
# Postgres cache: about one eighth of the server's RAM (production compose only)
# PG_SHARED_BUFFERS=512MB
CONTROL_DB=schoolsync_control
# API containers (production compose only): 1 on a 4 GB server, 2 on 8 GB or more
# API_REPLICAS=1

# openssl rand -base64 48
JWT_SECRET=
APP_ENCRYPTION_KEY=
PLATFORM_API_KEY=
# Operator console (/platform): first operator, created at startup while none exists; change the password at first sign-in, then clear it
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# extra hosts allowed to serve the console (the base domain and admin.<base> / platform.<base> always are)
# PLATFORM_CONSOLE_HOSTS=

PUBLIC_API_URL=https://schoolsync.example.com
# where people open the web app; {code} becomes the school's code (links in password-reset emails and receipts)
PUBLIC_WEB_URL=https://{code}.schoolsync.example.com
CORS_ORIGINS=https://schoolsync.example.com
MIN_APP_VERSION=1.0.0

# Firebase Cloud Messaging (server): paste the service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
SMTP_URL=
MAIL_FROM=SchoolSync <no-reply@schoolsync.example.com>
# SMTP_URL / MAIL_FROM are the PLATFORM default sender; each school can add its own email accounts in Settings.
# Pause between two queued emails of one school (ms). Never set ALLOW_PRIVATE_SMTP in production (the API refuses to start).
# EMAIL_SEND_INTERVAL_MS=300

# Production compose only: set by the deploy script (infra/scripts/deploy-remote.sh) on every release, do not edit
# REGISTRY=ghcr.io/your-github-user
# IMAGE_TAG=

# Names that OTHER apps on the same domain already use (comma separated): no school may take them, e.g. lahab,resto
# RESERVED_SITE_CODES_EXTRA=
# Production compose only: memory ceilings per container (defaults are small so SchoolSync can share a server)
# API_MEM=768m
# WEB_MEM=768m
# PG_MEM=1g
# REDIS_MEM=192m
# Shared server only (a reverse proxy of another app owns ports 80/443): see infra/docker-compose.shared.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared.yml
# EDGE_NETWORK=name-of-the-proxys-docker-network

