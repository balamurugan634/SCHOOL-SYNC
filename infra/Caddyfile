# Routing for every school: <code>.{$BASE_DOMAIN}, the base domain itself (marketing, /platform operator console) and any
# registered custom domain. Caddy forwards the Host header untouched, which is how the API and web resolve the school.
#
# HTTPS: certificates are issued ON DEMAND the first time a host is visited, but only for hosts the API confirms
# (GET /api/v1/site/tls-allowed, answered to internal callers only). No DNS-provider plugin and no wildcard record needed:
# point DNS at the server (`@` and `*`) and add schools in the operator console.
# Let's Encrypt allows 50 new certificates per week per registered domain: onboarding more than that at once? Use one
# wildcard certificate instead (build Caddy with your DNS provider's plugin and replace `tls { on_demand }` with the
# commented example below).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:4000/api/v1/site/tls-allowed
	}
}

# plain HTTP: ACME challenges are answered by Caddy itself before this runs; everything else goes to HTTPS
http:// {
	redir https://{host}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	# wildcard alternative:
	# tls {
	# 	dns hetzner {env.HETZNER_DNS_TOKEN}
	# }

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The operator API and the TLS check are for the internal network only: the console reaches the API from the web
	# container, so nothing outside the stack needs them. (Automation with PLATFORM_API_KEY: use an SSH tunnel.)
	@internal path /api/v1/platform/* /api/v1/site/tls-allowed
	handle @internal {
		respond 404
	}

	@api path /api/v1/* /docs
	handle @api {
		reverse_proxy api:4000 {
			lb_policy least_conn
			health_uri /api/v1/healthz
			health_interval 10s
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
