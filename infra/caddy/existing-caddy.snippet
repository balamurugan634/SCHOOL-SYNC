# SchoolSync behind an EXISTING Caddy (the one that already owns ports 80/443). Two small additions to that Caddy's Caddyfile.
# Replace sols-ai.com with your base domain. Back up the Caddyfile first and reload with:  docker exec <caddy> caddy reload --config /etc/caddy/Caddyfile
# The Caddy container must be on the same Docker network as SchoolSync (EDGE_NETWORK in /opt/schoolsync/.env).

# ── 1. In the existing global options block at the very top (there can be only ONE such block; add the lines to it,
#       or create the block if the file has none) ───────────────────────────────────────────────────────────────
{
	on_demand_tls {
		ask http://schoolsync-api:4000/api/v1/site/tls-allowed
	}
}

# ── 2. A new site block anywhere below. Hosts that already have their OWN block in this Caddyfile (lahab.sols-ai.com, ...)
#       keep using it: the most specific host wins. This block only receives the other names under the base domain, and
#       gets a certificate for a name only if SchoolSync says it is a real school (or the console host) ─────────────
*.sols-ai.com {
	tls {
		on_demand
	}

	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# the operator API and the certificate check are for the internal network only
	@internal path /api/v1/platform/* /api/v1/site/tls-allowed
	handle @internal {
		respond 404
	}

	@api path /api/v1/* /docs
	handle @api {
		reverse_proxy schoolsync-api:4000 {
			health_uri /api/v1/healthz
			health_interval 10s
		}
	}
	handle {
		reverse_proxy schoolsync-web:3000
	}
}
